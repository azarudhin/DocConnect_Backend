    {
      "name": "Connections",
      "item": [
        {
          "name": "Send Connection Request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"to\": \"{{targetUserId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/connect",
              "host": ["{{baseUrl}}"],
              "path": ["connect"]
            },
            "description": "Send connection request. Returns { status: 'Success', message: 'Request has be Sended' }"
          },
          "response": [
            {
              "name": "Connect Success Example",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "body": "{\n  \"status\": \"Success\",\n  \"message\": \"Request has be Sended\",\n  \"data\": {\n    \"from\": \"6acf3bd160ea3589df9e02e0\",\n    \"to\": \"6acf3bd160ea3589df9e02e1\"\n  }\n}"
            },
            {
              "name": "Connect Already Sent Example",
              "status": "Bad Request",
              "code": 400,
              "_postman_previewlanguage": "json",
              "body": "{\n  \"status\": 400,\n  \"message\": \"Request will be All ready Send\"\n}"
            },
            {
              "name": "Connect Failed Example",
              "status": "Bad Request",
              "code": 400,
              "_postman_previewlanguage": "json",
              "body": "{\n  \"status\": 400,\n  \"message\": \"failed to send Request\"\n}"
            }
          ]
        },
        {
          "name": "Remove / Withdraw Connection",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"to\": \"{{targetUserId}}\",\n  \"action\": \"remove\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/connect",
              "host": ["{{baseUrl}}"],
              "path": ["connect"]
            },
            "description": "Withdraw / remove connection request"
          },
          "response": []
        }
      ]

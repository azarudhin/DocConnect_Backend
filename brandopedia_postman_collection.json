  "item": [
    {
      "name": "Feed",
      "item": [
        {
          "name": "Get Feed (Standardized Response)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/posts",
              "host": ["{{baseUrl}}"],
              "path": ["posts"]
            },
            "description": "Fetch the feed containing currentUser and posts array"
          },
          "response": [
            {
              "name": "Feed Success Example",
              "originalRequest": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/posts",
                  "host": ["{{baseUrl}}"],
                  "path": ["posts"]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"status\": \"Success\",\n  \"message\": \"Feed fetched successfully\",\n  \"data\": {\n    \"currentUser\": {\n      \"id\": \"6acf3bd160ea3589df9e02e0\",\n      \"name\": \"Dr. Arjun Mehta\",\n      \"occupation\": \"Cardiology\",\n      \"profileImage\": \"http://localhost:5000/images/user1.png\",\n      \"connectionsCount\": 2\n    },\n    \"posts\": [\n      {\n        \"id\": \"6acf3bd160ea3589df9e02e5\",\n        \"content\": \"Welcome to Docconnect! We're building India's largest healthcare professional network. Connect with doctors, nurses, pharmacists, and medical students across the country.\",\n        \"images\": [\n          \"http://localhost:5000/images/post1.png\"\n        ],\n        \"likesCount\": 5,\n        \"sharesCount\": 3,\n        \"commentsCount\": 0,\n        \"isLiked\": false,\n        \"createdAt\": \"2026-10-14T08:22:41.387Z\",\n        \"author\": {\n          \"id\": \"6acf3bd160ea3589df9e02e1\",\n          \"name\": \"Docconnect\",\n          \"occupation\": \"Healthcare Technology\",\n          \"profileImage\": \"http://localhost:5000/images/user2.png\",\n          \"connectionsCount\": 2\n        }\n      }\n    ]\n  }\n}"
            }
          ]
        },
        {
          "name": "Like / Unlike Post",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isLiked\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/posts/{{samplePostId}}/like",
              "host": ["{{baseUrl}}"],
              "path": ["posts", "{{samplePostId}}", "like"]
            },
            "description": "Toggle like on a post (pass isLiked: true to like, isLiked: false to unlike)"
          },
          "response": []
        }
      ]
    },
